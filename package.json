{
  "name": "travy",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "tools",
    "app"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p shared && tsc -p tools && npm run typecheck -w @travy/app",
    "content:check": "tsx tools/src/cli/check.ts",
    "content:build": "tsx tools/src/cli/build.ts",
    "content:app": "npm run content:build && tsx tools/src/cli/app-content.ts",
    "photo:fetch": "tsx tools/src/cli/fetch-photo.ts",
    "sources:verify": "tsx tools/src/cli/verify-sources.ts",
    "content:report": "tsx tools/src/cli/report.ts",
    "app:icons": "tsx tools/src/cli/app-icons.ts",
    "app:web": "npm run web -w @travy/app"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
